{
  "name": "@clearsign/core",
  "version": "0.1.0",
  "description": "Soroban Clear-Sign Kit - Core decoding, XDR parsing, and transaction simulation engine",
  "license": "Apache-2.0",
  "keywords": [
    "stellar",
    "soroban",
    "clear-signing",
    "transaction-preview",
    "xdr",
    "wallet-security"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "record:fixture": "node scripts/record-fixture.js",
    "bench": "vitest bench --run test/bench",
    "check:security-model": "node scripts/check-security-model.js",
    "check:packaging": "publint && attw --pack",
    "docs:api": "typedoc",
    "test:examples": "node examples/decode-envelope.js && node examples/summarize-simulation.js && node examples/evaluate-policy.js",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:coverage": "vitest run --dir test/unit --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:security-model && pnpm run check:packaging && pnpm run test:coverage",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=17.1.0 <=17.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^10.0.1",
    "@stellar/stellar-sdk": "17.4.0",
    "@types/node": "^22.5.5",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsup": "^8.3.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.1"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
