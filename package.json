{
  "name": "@clearsign/core",
  "version": "0.1.0",
  "description": "Soroban Clear-Sign Kit - Core decoding, XDR parsing, and transaction simulation engine",
  "license": "Apache-2.0",
  "keywords": [
    "stellar",
    "soroban",
    "clear-signing",
    "transaction-preview",
    "xdr",
    "wallet-security"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format:check": "prettier --check .",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:coverage": "vitest run --dir test/unit --coverage",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.5.5",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.1"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  }
}
